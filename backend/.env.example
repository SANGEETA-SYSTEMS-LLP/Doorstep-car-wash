PORT=5000
# Use your HTTPS frontend origin(s) in production, comma-separated if needed.
FRONTEND_URL=http://localhost:5173
# Set only to the number of trusted reverse proxies in front of the API (default 0).
TRUST_PROXY_HOPS=0
# Must match VITE_GST_RATE_PERCENT in frontend/.env when GST applies.
GST_RATE_PERCENT=18
GEOCODING_BASE_URL=https://nominatim.openstreetmap.org
# Set a deployment-identifying User-Agent and public contact for production.
GEOCODING_USER_AGENT=
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-public-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-secret
RAZORPAY_KEY_ID=replace-with-test-key-id
RAZORPAY_KEY_SECRET=replace-with-test-secret
RAZORPAY_WEBHOOK_SECRET=replace-with-webhook-secret

# Automatic washer payouts (separate RazorpayX credentials)
RAZORPAYX_KEY_ID=
RAZORPAYX_KEY_SECRET=
RAZORPAYX_ACCOUNT_NUMBER=
# Local-only payout simulation; ignored unless NODE_ENV=development.
RAZORPAYX_MOCK_ENABLED=false
# Persistent 32-byte base64 key for encrypting saved washer bank/UPI details.
PAYOUT_DATA_ENCRYPTION_KEY=
FINANCE_RECONCILIATION_ENABLED=false
# Seller information printed on service invoices (not GST tax invoices)
INVOICE_BUSINESS_NAME=
INVOICE_BUSINESS_ADDRESS=
