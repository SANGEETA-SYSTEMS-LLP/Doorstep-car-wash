PORT=5000
FRONTEND_URL=http://localhost:5173
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-public-key
SUPABASE_SECRET_KEY=your-server-only-secret
RAZORPAY_KEY_ID=your-test-key-id
RAZORPAY_KEY_SECRET=your-test-secret
RAZORPAY_WEBHOOK_SECRET=your-webhook-secret
# npm run dev enables local test access. Keep disabled for normal/production startup.
TEST_MODE=false

# Automatic washer payouts (separate RazorpayX credentials)
RAZORPAYX_KEY_ID=
RAZORPAYX_KEY_SECRET=
RAZORPAYX_ACCOUNT_NUMBER=
FINANCE_RECONCILIATION_ENABLED=false
# Seller information printed on service invoices (not GST tax invoices)
INVOICE_BUSINESS_NAME=
INVOICE_BUSINESS_ADDRESS=
